# Copy to .env and fill in. Never commit .env.
# ================= $0/month FREE MODE (default) =================
QB_MODE=free                        # free | paid

# ---- Credentials ----
THE_ODDS_API_KEY=                   # free tier key from the-odds-api.com (500 credits/month)
TELEGRAM_BOT_TOKEN=                 # from @BotFather (free)
TELEGRAM_CHAT_ID=

# ---- Honest identification & politeness ----
QB_USER_AGENT="quantbet-signal-engine/0.2 (personal, read-only)"   # honest; ESPN 403ed a placeholder "; contact: you@example.com" suffix
QB_HTTP_BACKEND=aiohttp             # aiohttp | curl_cffi (plain client, never impersonates)
QB_POLITE_MIN_INTERVAL_S=15         # per URL = per match per source; do not lower
QB_POLITE_GLOBAL_CONCURRENCY=2
QB_POLITE_GLOBAL_GAP_S=1
QB_POLITE_JITTER_S=3
QB_POLITE_BACKOFF_BASE_S=60         # 403/429/503/challenge -> exponential backoff
QB_POLITE_BACKOFF_MAX_S=3600
QB_HTTP_CACHE_PATH=data/http_cache.sqlite3

# ---- Tier 1: ESPN public site API (primary; unofficial - check ESPN's terms) ----
QB_ENABLE_ESPN=true
QB_ESPN_BASE=https://site.api.espn.com/apis/site/v2/sports/soccer
QB_ESPN_LEAGUES=["eng.1","esp.1","ger.1","ita.1","fra.1","uefa.champions","uefa.europa"]
# --cups adds: uefa.europa.conf (id 20296), eng.league_cup (3920) [verified], eng.fa, esp.copa_del_rey,
# ger.dfb_pokal, ita.coppa_italia, fra.coupe_de_france [ids learnt at startup; unknown slugs dropped]
# Live Telegram (scripts/live.sh): TELEGRAM_BOT_TOKEN=... TELEGRAM_CHAT_ID=... (no QB_ prefix)
QB_ESPN_USE_ALL=true                # one soccer/all/scoreboard per cycle (filtered by league in memory)
QB_ESPN_ALL_POLL_S=60               # + random 2-5 s jitter
QB_ESPN_SUMMARY_ONCE=true           # /summary once per match (DraftKings prior), never in play
QB_ESPN_SUMMARY_DB_PATH=data/espn_summary.sqlite3
QB_ESPN_SCOREBOARD_POLL_S=60        # per league while live/kick-off within 15 min; ESPN edge 403ed bursts, do not lower
QB_ESPN_IDLE_POLL_S=600             # per league when nothing is live
QB_ESPN_SUMMARY_POLL_S=60           # per in-play match
QB_ESPN_PREKICK_WINDOW_MIN=45       # plumbing: /summary priority for listed leagues within 45 min of kick-off
QB_ESPN_PREKICK_SUMMARIES_PER_CYCLE=4  # own per-cycle budget for those (polite_http pacing still applies)
QB_ESPN_PREKICK_REFRESH_MIN=10      # one late pre-match refresh in the last 10 min (0 = off)
QB_DEDUP_HYDRATE_LOOKBACK_S=10800   # rebuild dedup / match caps from data/quantbet.sqlite3 on start-up
QB_ESPN_USE_SUMMARY=true
QB_ESPN_USE_PICKCENTER_PRIOR=true   # DraftKings pre-match lines on ESPN as goals prior (never shown as Bet365)
QB_SYNTHETIC_MOMENTUM=true          # DeltaTracker momentum when no graph momentum
QB_FREE_MAX_LIVE_EVENTS=6           # per league per cycle
QB_FREE_LEAGUE_FILTER=[]            # optional name substrings, e.g. ["Premier League","LALIGA"]

# ---- Tier 2: API-Football free tier (optional; off without key) ----
API_FOOTBALL_KEY=
QB_ENABLE_API_FOOTBALL_FREE=true
QB_API_FOOTBALL_DAILY_LIMIT=100
QB_API_FOOTBALL_USE_LIMIT=90        # hard stop per UTC day
QB_API_FOOTBALL_DB_PATH=data/api_football.sqlite3

# ---- Tier 3: FotMob match page __NEXT_DATA__ (opt-in; check FotMob's terms) ----
QB_ENABLE_FOTMOB_PAGE=true          # confirmation only: minute 50-85 and EV at neutral reference >= 1 %
QB_FOTMOB_EV_GATE=0.010
QB_FOTMOB_DROP_CONTRADICTED=true
QB_DROP_NEGATIVE_REFERENCE_EV=true
QB_FOTMOB_PAGE_INTERVAL_S=300
QB_FOTMOB_PAGE_ONLY_FLAGGED=true

# ---- Legacy fallbacks (off; SofaScore 403s honest clients - never impersonated) ----
QB_ENABLE_SOFASCORE=false
QB_ENABLE_FOTMOB=false
QB_SOFASCORE_BASE=https://api.sofascore.com/api/v1
QB_FOTMOB_BASE=https://www.fotmob.com/api/data
QB_STATS_POLL_S=30
QB_LIST_POLL_S=60

# ---- Layer 2: optional aggregator odds (off) ----
QB_ENABLE_SOFASCORE_ODDS=false
QB_SOFASCORE_ODDS_PROVIDER_ID=1
QB_SOFASCORE_ODDS_LABEL=sofascore_provider   # set to bet365 ONLY if you verified the provider

# ---- Layer 1: The-Odds-API free-tier budget ----
QB_ENABLE_THE_ODDS_API=true
QB_ODDS_MONTHLY_BUDGET=500
QB_ODDS_BUDGET_RESERVE=20
QB_ODDS_PRIORITY_WINDOW_H=3
QB_ODDS_MIN_REFRESH_S=10800
QB_THE_ODDS_API_SPORTS=["soccer_epl","soccer_germany_bundesliga","soccer_italy_serie_a","soccer_spain_la_liga"]
QB_THE_ODDS_API_EU_BOOKMAKERS=["pinnacle","betfair_ex_eu","williamhill","unibet_eu","marathonbet","onexbet"]
QB_ODDS_CACHE_PATH=data/odds_cache.sqlite3

# ---- Calibration outputs (scripts/calibrate.py) ----
QB_FOOTBALL_DATA_RATINGS_PATH=config/team_ratings.json
QB_ENGINE_B_PARAMS_PATH=config/engine_b_params.json

# ---- Min-odds pricing ----
QB_TARGET_EDGE=0.025                # EV at MINIMUM BET365 ODDS
QB_ABORT_EDGE=0.015                 # abort floor
QB_MIN_ALERT_MINUTE=10
QB_MAX_ALERT_MINUTE=86
QB_REALERT_COOLDOWN_S=600

# ---- Risk ----
QB_BANKROLL=2000
QB_UNIT_SIZE=10
QB_CURRENCY=EUR                     # EUR | USD | GBP ... (symbol used in tier line)
QB_KELLY_MULTIPLIER=0.25
QB_MAX_STAKE_FRACTION=0.03
# Alert rules: v4.2 (frozen in config/engine_b_params.json; --unfreeze to override) | v4.1, v4 (superseded) | v3 | legacy
#   v4.3-global = v4.2 maths unchanged + 45-league registry, liquidity tiers, Live Stats Integrity Gate,
#   slug priors (own freeze under frozen_sets["v4.3-global"], sha256 971ab886...)
#   v4.4-syndicate = v4.3-global + tier EV hurdles, sustained momentum, Unders (tempo_stall / bus_parking),
#   cards family, per-family cooldown/re-alert rules, [BOOST TARGET] + [BET BUILDER / 3-WAY COMBO]
#   (own freeze under frozen_sets["v4.4-syndicate"], sha256 c3a6d97a...)
#   v4.5-sharp (DEFAULT) = v4.4-syndicate + registered-leagues-only / youth filter, TIER_3 goals-only,
#   windows 34-43 & 55-83, hurdles 3.5/4.5/6%, lift caps 20%/22%, flurry cap, 2nd-half tempo_stall,
#   Total Cards yellow 1 / red 2 (NegBin, PAPER ONLY), gated Bet Builder (own freeze under frozen_sets["v4.5-sharp"])
QB_ALERT_RULES=v4.5-sharp
# QB_ALERT_RULES=v4.4-syndicate
# QB_ALERT_RULES=v4.3-global
# QB_ALERT_RULES=v4.2
QB_LEAGUES_CONFIG_PATH=config/leagues.json   # v4.3-global league registry (tiers, corner/goals baselines)
QB_SYNDICATE_PRIORS_PATH=config/syndicate_priors.json   # cards baselines + rho priors (hashed into the v4.4 / v4.5 freezes)
QB_MAX_MATCH_STAKE_FRAC=0.05
QB_FAMILY_COOLDOWN_MIN=15

# ---- Runtime ----
QB_DB_PATH=data/quantbet.sqlite3
QB_LOG_LEVEL=INFO
QB_LOG_JSON=true
QB_DRY_RUN=true                     # log alerts instead of sending to Telegram

# ================= PAID MODE (legacy; all off) =================
ODDS_API_IO_KEY=
BETSAPI_TOKEN=
# API_FOOTBALL_KEY is set above (also used by the paid adapter)
SPORTMONKS_TOKEN=
QB_ENABLE_ODDS_API_IO=false
QB_ENABLE_ODDS_API_IO_WS=false
QB_ENABLE_BETSAPI=false
QB_ENABLE_API_FOOTBALL=false
QB_ENABLE_SPORTMONKS=false

# Gemini consult bridge (scripts/consult_gemini.py). Put the real key in .env only.
# GEMINI_API_KEY=
